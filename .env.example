# ============================================================
# SmartSportz - deployment environment
#
# On the server this file lives at /opt/smartdeploy/.env - OUTSIDE the git
# clone, so the `git reset --hard` / `git clean -fd` in scripts/deploy.sh
# cannot delete it, and so it can never be committed by accident.
#
#   sudo install -m 600 /dev/null /opt/smartdeploy/.env
#   sudo nano /opt/smartdeploy/.env
#
# Every value below is a placeholder. Fill in real values on the server only.
# ============================================================

# ------------------------------------------------------------
# Published ports
#
# Bound to loopback: the host nginx in deploy/nginx/smartdeploy.conf is the
# only public entry point. Set BIND_ADDR=0.0.0.0 only if you intentionally
# want a service reachable without the reverse proxy.
#
# Defaults avoid ports commonly taken on a shared box - 8080 is Jenkins and
# 3000 is a distro grafana-server on many hosts.
# ------------------------------------------------------------
BIND_ADDR=127.0.0.1
FRONTEND_PORT=8081
BACKEND_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Must list the public origin nginx serves, or the browser gets CORS errors.
# The http:// entry is only needed before certbot is run - drop it once TLS
# is live so the API stops accepting a plaintext origin.
ALLOWED_ORIGINS=https://test.smartsportz.in,http://test.smartsportz.in

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
# Generate with: openssl rand -hex 32
APP_SECRET_KEY=CHANGE_ME

APP_ENV=docker
DATABASE_BACKEND=sqlite
DATABASE_PATH=storage/smartsportz.db
MIRROR_DATABASE_PATH=storage/smartsportz_mirror.db
AUDIT_DATABASE_PATH=storage/smartsportz_audit.db
DATABASE_URL=
MIRROR_DATABASE_URL=
AUDIT_DATABASE_URL=

AUTO_MIRROR_SYNC=false
INIT_DB_ON_STARTUP=false
SEED_DB_ON_STARTUP=false
CLEANUP_MEDIA_ON_STARTUP=false

PUBLIC_CACHE_TTL_SECONDS=300
DASHBOARD_CACHE_TTL_SECONDS=120

# Left empty: docker-compose.yml sets REDIS_URL per service to the in-network
# redis container. Only set this to point at an external Redis.
REDIS_URL=

# ------------------------------------------------------------
# Supabase / Postgres (unused while DATABASE_BACKEND=sqlite)
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DIRECT_DATABASE_URL=
POSTGRES_PRIMARY_SCHEMA=
POSTGRES_MIRROR_SCHEMA=
POSTGRES_AUDIT_SCHEMA=

# ------------------------------------------------------------
# Grafana
# ------------------------------------------------------------
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME

# ------------------------------------------------------------
# Twilio
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_DEFAULT_TO=

# ------------------------------------------------------------
# Email
#
# EMAIL_PROVIDER selects the transport in
# backend/app/services/notifications.py:
#
#   brevo  - HTTPS POST to api.brevo.com (port 443). Recommended.
#            Unaffected by the missing PTR record on this server's IP, and
#            by hosts that block outbound SMTP.
#   resend - HTTPS POST to api.resend.com. Same idea, different vendor.
#   smtp   - direct SMTP to SMTP_HOST. Uses the self-hosted mail server.
#            Deliverability depends on the server IP having reverse DNS.
#
# Brevo requires the sender domain to be authenticated in their dashboard
# (Senders, Domains & Dedicated IPs -> Domains) before it will accept mail
# from info@smartsportz.in. That step publishes a brevo-code TXT record and
# a DKIM record you add at GoDaddy.
# ------------------------------------------------------------
EMAIL_PROVIDER=brevo

BREVO_API_KEY=
BREVO_SENDER_EMAIL=info@smartsportz.in
BREVO_SENDER_NAME=Smart Sportz
# true redirects EVERY message to BREVO_TEST_TO_EMAIL regardless of the real
# recipient - useful in staging, but it silently breaks OTP delivery to real
# users, so keep it false in anything people actually log in to.
BREVO_FORCE_TEST_RECIPIENT=false
BREVO_TEST_TO_EMAIL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_ACCOUNT_EMAIL=
RESEND_FORCE_TEST_RECIPIENT=false
RESEND_TEST_TO_EMAIL=

PRIVILEGED_OTP_EMAIL=

# Self-hosted mail server at mail.smartsportz.in. Used only when
# EMAIL_PROVIDER=smtp; kept here as a fallback and for inbound mail.
SMTP_HOST=mail.smartsportz.in
SMTP_PORT=587
SMTP_USERNAME=info@smartsportz.in
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_USE_TLS=true
SMTP_SENDER_NAME=Smart Sportz
SMTP_SENDER_EMAIL=info@smartsportz.in

# ------------------------------------------------------------
# Delivery modes
# ------------------------------------------------------------
OTP_DELIVERY_MODE=email
NOTIFICATION_DELIVERY_MODE=email
WHATSAPP_DELIVERY_ENABLED=false
WHATSAPP_PROVIDER=disabled
WHATSAPP_DEFAULT_TO=

# ------------------------------------------------------------
# Upstash (optional managed Redis)
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------
# Google OAuth
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

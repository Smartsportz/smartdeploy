# docker-mailserver configuration for mail.smartsportz.in
# Full reference: https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/

# ---- Identity ----
POSTMASTER_ADDRESS=info@smartsportz.in

# ---- TLS ----
# Uses the certbot certificate for mail.smartsportz.in mounted from the host.
# setup.sh obtains it and installs a renewal hook that restarts this container.
SSL_TYPE=letsencrypt

# ---- Mail authentication (all three are required by your DMARC policy) ----
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_POLICYD_SPF=1

# Refuse mail that forges one of your own addresses as the sender.
SPOOF_PROTECTION=1

# ---- Filtering ----
ENABLE_SPAMASSASSIN=1
MOVE_SPAM_TO_JUNK=1
# ClamAV needs roughly 1GB of RAM on its own. Set to 1 only if the box has it.
ENABLE_CLAMAV=0
# Greylisting cuts spam but delays first-time senders by minutes - bad for OTP.
ENABLE_POSTGREY=0

# ---- Abuse protection ----
ENABLE_FAIL2BAN=1

# ---- Access ----
# Do not treat the whole Docker network as trusted; the app authenticates
# with real SMTP credentials on 587 like any other client.
PERMIT_DOCKER=none

ENABLE_IMAP=1
# POP3 is not needed; leaving it off reduces exposed surface.
ENABLE_POP3=0

LOG_LEVEL=info

# ------------------------------------------------------------
# OUTBOUND RELAY (optional)
#
# Uncomment to send all outbound mail through Brevo instead of delivering
# directly from this server. Use this when the host will not set a PTR
# record for the server's IP - Gmail and Outlook apply a large penalty
# (SpamAssassin RDNS_NONE, -1.274) to any IP without reverse DNS.
#
# Inbound mail is unaffected: the MX still points here, and mail for
# info@smartsportz.in is still delivered locally.
#
# DKIM survives the relay - OpenDKIM signs the message here, before it is
# handed to Brevo, so the signature and DMARC alignment stay intact.
#
# RELAY_PASSWORD is the Brevo *SMTP key* (SMTP & API -> SMTP tab), which is
# a different credential from the API key.
#
# After enabling, SPF must authorise Brevo as well. Update the single TXT
# record at the apex to:
#   v=spf1 ip4:163.128.110.169 a:mail.smartsportz.in include:spf.brevo.com ~all
#
# RELAY_HOST=smtp-relay.brevo.com
# RELAY_PORT=587
# RELAY_USER=your-brevo-login@example.com
# RELAY_PASSWORD=your-brevo-smtp-key
